# nanoMuse Cloud 部署配置
# 本地/局域网模式（无 TLS，验证码输出到日志）

# ============================================
# 基础配置
# ============================================

# 公开访问地址（IP 方式，无域名）
PUBLIC_BASE=http://124.221.28.203:8789

# ============================================
# 安全配置
# ============================================

# 加密密钥（32字节随机十六进制字符串）
# 警告：旋转此密钥会使所有账户失效！请备份。
CLOUD_SECRET=change-me-to-random-32-hex-chars

# 管理员密码（访问 /app/admin/ 管理页面）
CLOUD_ADMIN_TOKEN=change-me-to-admin-password

# ============================================
# 模型 API 配置
# ============================================

# 上游模型提供商（OpenAI 兼容接口）
UPSTREAM_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_KEY=sk-ff84a4311f0d484581f7decac8b54829

# 聊天默认设置
CHAT_DEFAULTS={"enable_thinking": false}

# ============================================
# 用户注册
# ============================================

# 1 = 开放注册（任何人可注册）
# 0 = 仅 ALLOWED_IDENTIFIERS 中的用户可注册（私有模式）
SIGNUP_OPEN=1

# 每个账号的终身额度（元），0 = 无限制
ALLOWANCE_CNY=10

# 邀请奖励（元）
INVITE_BONUS_CNY=5

# ============================================
# 验证码发送方式
# ============================================

# log   - 打印到服务器日志（开发模式，推荐）
# smtp  - 邮件发送（需配置 SMTP）
# aliyun - 阿里云短信（中国大陆手机号）
# both  - 邮件+短信
CODE_SENDER=log

# ============================================
# Hub 设备协作
# ============================================

HUB_ENABLED=true
HUB_FRAME_LIMIT=16777216

# ============================================
# 数据控制
# ============================================

# 0 = 默认关闭数据分享（用户可在设置中开启）
IMPROVE_DEFAULT=0

# 隐私政策 URL
PRIVACY_URL=https://nanomuse.cn/privacy/

# 时区偏移（8 = 北京时间）
DAY_OFFSET_H=8

# ============================================
# 请求限制
# ============================================

# 每分钟请求限制（防止失控循环消耗额度）
PER_MINUTE_REQUESTS=30

# ============================================
# 本地部署覆盖
# ============================================

# 绑定地址（0.0.0.0 = 允许外部访问）
RELAY_BIND=0.0.0.0

# 端口（容器内部固定 8787，此处映射到宿主机端口）
RELAY_PORT=8789
