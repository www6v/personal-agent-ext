# nanoMuse Cloud 本地部署配置
# 复制此文件为 .env 并修改配置

# ============================================
# 基础配置
# ============================================

# 公开访问地址
# 本机访问: http://127.0.0.1:8787
# 局域网访问: http://192.168.x.x:8787
PUBLIC_BASE=http://127.0.0.1:8787

# 绑定地址
# 127.0.0.1 - 仅本机访问
# 0.0.0.0   - 允许局域网访问
RELAY_BIND=127.0.0.1
RELAY_PORT=8787

# ============================================
# 安全配置
# ============================================

# 加密密钥（自动生成随机字符串）
# openssl rand -hex 32
CLOUD_SECRET=change-me-to-random-string

# 管理员密码
CLOUD_ADMIN_TOKEN=admin-password-here

# ============================================
# 模型 API 配置
# ============================================

# 使用阿里云百炼 (Qwen)
UPSTREAM_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_KEY=sk-ff84a4311f0d484581f7decac8b54829

# 聊天默认设置
CHAT_DEFAULTS={"enable_thinking": false}

# ============================================
# 用户注册
# ============================================

# 是否开放注册
# 1 - 任何人可注册
# 0 - 仅 ALLOWED_IDENTIFIERS 中的用户可注册
SIGNUP_OPEN=1

# 每个账号的额度（元）
# 0 = 无限制
ALLOWANCE_CNY=0

# ============================================
# 验证码发送方式
# ============================================

# log   - 打印到日志（开发模式）
# smtp  - 邮件发送
# aliyun - 阿里云短信
# both  - 邮件+短信
CODE_SENDER=log

# ============================================
# Hub 设备协作
# ============================================

HUB_ENABLED=true

# ============================================
# 其他配置
# ============================================

# 每分钟请求限制
PER_MINUTE_REQUESTS=60

# 每日 token 限制（0=无限制）
DAILY_CAP_TOKENS=0

# 隐私政策 URL
PRIVACY_URL=

# 时区偏移（8=北京时间）
DAY_OFFSET_H=8
